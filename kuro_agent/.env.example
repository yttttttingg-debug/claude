# Gemini（免費）
# 申請：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=你的_gemini_key

# ElevenLabs（你已有帳號）
# 在 ElevenLabs 設定頁找到 API Key
ELEVENLABS_API_KEY=你的_elevenlabs_key
# 建立 KURO 聲音後，把 Voice ID 填在這
KURO_VOICE_ID=你的_kuro_voice_id

# YouTube（OAuth 授權後自動存 token，這裡填檔案路徑就好）
YOUTUBE_CLIENT_SECRETS=credentials.json
