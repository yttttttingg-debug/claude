# Required: Claude API key from the Anthropic console
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AI_SYSTEM_PROMPT=你是一個樂於助人的 AI 助理，請用繁體中文簡潔回覆。

# Server port (used for the health check endpoint and the LINE webhook)
PORT=3000

# --- Enable any combination of the platforms below by filling in its token(s) ---

# Telegram: get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Discord: Discord Developer Portal > your application > Bot > Token
DISCORD_BOT_TOKEN=

# LINE: LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Scheduled tasks (run continuously for as long as the service stays up) ---

# Optional: a URL to health-check on a schedule; alerts are sent if it goes down
MONITOR_URL=
MONITOR_CRON=*/30 * * * *
DAILY_REPORT_CRON=0 9 * * *
RANDOM_TASK_CRON=0 */6 * * *

# Where to deliver scheduled task output. Only the platforms you fill in are used.
REPORT_TELEGRAM_CHAT_ID=
REPORT_DISCORD_CHANNEL_ID=
REPORT_LINE_USER_ID=
