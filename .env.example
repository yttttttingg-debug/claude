# 複製此檔案為 .env 並填入你的金鑰
# cp .env.example .env

# Google Gemini API 金鑰（取得：https://aistudio.google.com/apikey）
GEMINI_API_KEY=你的_gemini_api_金鑰

# Telegram Bot Token（從 @BotFather 取得）
TELEGRAM_BOT_TOKEN=你的_telegram_bot_token

# 後端選擇：gemini（預設）或 ollama
HERMES_BACKEND=gemini

# 模型設定（可選）
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=hermes3
