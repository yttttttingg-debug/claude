# Required: Gemini API key, free from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SYSTEM_PROMPT=你是一個樂於助人的 AI 助理，請用繁體中文簡潔回覆。

# Server port (used for the health check endpoint and the LINE webhook)
PORT=3000

# --- Enable any combination of the platforms below by filling in its token(s) ---

# Telegram: get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Discord: Discord Developer Portal > your application > Bot > Token
DISCORD_BOT_TOKEN=

# LINE: LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Scheduled tasks (run continuously for as long as the service stays up) ---

# Optional: a URL to health-check on a schedule; alerts are sent if it goes down
MONITOR_URL=
MONITOR_CRON=*/30 * * * *
DAILY_REPORT_CRON=0 9 * * *
RANDOM_TASK_CRON=0 */6 * * *

# Where to deliver scheduled task output. Only the platforms you fill in are used.
REPORT_TELEGRAM_CHAT_ID=
REPORT_DISCORD_CHANNEL_ID=
REPORT_LINE_USER_ID=

# --- YouTube channel automation (optional) ---
# Leave these blank to disable: the channel/comment-reply tasks and the
# /newvideo (Telegram) or !newvideo (Discord) chat commands will just no-op.
#
# Get YOUTUBE_CLIENT_ID/SECRET from Google Cloud Console (OAuth client, "Desktop app" type,
# with the YouTube Data API v3 enabled), then run `npm run youtube:auth` locally once to
# get YOUTUBE_REFRESH_TOKEN. See README for the full walkthrough.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# What the channel is about, used when the AI invents its own video topics
YOUTUBE_CHANNEL_TOPIC=生活實用小知識

# Edge neural TTS voice for the free voiceover (no API key needed)
YOUTUBE_TTS_VOICE=zh-TW-HsiaoChenNeural

# Safety default: newly generated videos upload as private so you can review before
# making them public. Set to "public" only once you trust the pipeline's output.
YOUTUBE_UPLOAD_PRIVACY_STATUS=private

YOUTUBE_CHANNEL_TASK_CRON=0 10 * * *
YOUTUBE_COMMENT_REPLY_CRON=15 * * * *
